# ---------------------------------------------------------------------------
# Foxxy backend environment.
#
# Copy to `.env`. Every variable below is read exactly once, at boot, by
# src/platform/config. A missing REQUIRED variable stops the process with a
# clear message — it never fails later on one rare code path.
#
# REQUIRED = no default; the server refuses to start without it.
# OPTIONAL = has a safe default; listed here so it is discoverable.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# OPTIONAL. One of: development | test | production. Default: development.
NODE_ENV=development
# OPTIONAL. Port the Fastify server listens on. Default: 4000.
PORT=4000
# OPTIONAL. Interface to bind. Default: 0.0.0.0 (required inside containers).
HOST=0.0.0.0
# OPTIONAL. pino level: fatal|error|warn|info|debug|trace. Default: info.
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# REQUIRED. Postgres 16 + pgvector. Must match docker/compose.yml in dev.
# Port 5433, not 5432: a natively installed Postgres commonly already holds
# 5432, and the failure mode is a confusing "password authentication failed"
# against the wrong server rather than a connection refused.
DATABASE_URL=postgres://foxxy:foxxy_dev_password@localhost:5433/foxxy
# OPTIONAL. Max connections for the single unnamed pool used by migrations and
# scripts. The APPLICATION does not use it — see the four bulkheads below.
# Default: 10.
DATABASE_POOL_MAX=10
# OPTIONAL. Set true when the database requires TLS (managed hosts). Default: false.
DATABASE_SSL=false

# --- Database bulkheads (04-RESILIENCE-PLAN.md section 3.1) ----------------
# One independently capped pool per concern, NOT one shared pool. The highest-
# value isolation in the system: with a single pool, one slow vector-search
# path eventually holds every connection and login starts failing — an outage
# caused by search. With these, retrieval degrades and nothing else notices.
#
# Total is 44, inside a default max_connections of 100 with room for psql —
# which matters, because the moment you most need psql is the moment the pools
# are full.
#
# OPTIONAL. identity + sessions. MUST NEVER BE STARVED. Default: 10.
DATABASE_POOL_AUTH_MAX=10
# OPTIONAL. Ordinary request traffic. Default: 20.
DATABASE_POOL_CORE_MAX=20
# OPTIONAL. Vector search. Capped so it CANNOT exhaust the others. Default: 8.
DATABASE_POOL_AI_MAX=8
# OPTIONAL. Background jobs; must never compete with live traffic. Default: 6.
DATABASE_POOL_WORKER_MAX=6

# OPTIONAL, and NOT a harmless default. pgvector's HNSW search breadth, applied
# as a startup parameter on the `ai` pool only. Default: 100.
#
# An HNSW index scan returns NO MORE ROWS THAN THIS, whatever the LIMIT says,
# and pgvector's own default is 40 while retrieval asks for the top 50.
# Measured on pgvector 0.8.6: ef_search 40 with `limit 50` returns 40 rows;
# ef_search 100 returns 50. Left unset, retrieval silently receives 40
# candidates every time — which reads as "the corpus is thin" and invites
# re-ingesting content that is already there.
#
# Rule: keep this at least as large as the largest LIMIT any retrieval query
# uses. See D-041 and D-049.
DATABASE_HNSW_EF_SEARCH=100

# --- Cache / rate limiting -------------------------------------------------
# REQUIRED. Valkey (Redis protocol). Rate-limit counters and caches live here,
# never in process memory — see 00-ARCHITECTURE.md section 7.
REDIS_URL=redis://localhost:6379

# --- HTTP ------------------------------------------------------------------
# REQUIRED, BOTH OF THEM. Two lists, not one — open item 1.
#
# There used to be a single CORS_ORIGINS serving both the CORS allow-list and
# the CSRF origin check. That conflates two different grants: adding a partner
# origin so their dashboard can GET a read-only report ALSO handed them
# state-changing rights across the whole API, silently, in a commit that looked
# like a read integration.
#
#   CORS_READ_ORIGINS   browsers here may call the API and see the answer.
#   CORS_WRITE_ORIGINS  browsers here may also POST / PUT / PATCH / DELETE.
#
# THE RELATIONSHIP: write is a SUBSET of read, and the app REFUSES TO START if
# it is not. An origin allowed to POST must be able to read the response to its
# POST, so a write-without-read grant is not a stricter policy — it is a broken
# one, where the server acts on the request and the browser then refuses to show
# the caller what happened.
#
# THE SENSIBLE DEFAULT: write = your own application origin, and nothing else.
# read = that, plus any read-only integration. Neither has a default in code:
# defaulting write to read would restore exactly the behaviour this splits
# apart, invisibly, so a deployment that has not thought about the distinction
# fails at boot and thinks about it.
#
# APP_URL is always allowed to write, whether or not it appears below, so that
# trimming this list cannot take the product down.
CORS_READ_ORIGINS=http://localhost:3000
CORS_WRITE_ORIGINS=http://localhost:3000
# OPTIONAL. Timeout in ms for outbound HTTP calls. Default: 10000.
HTTP_TIMEOUT_MS=10000
# OPTIONAL. Retry attempts for idempotent outbound calls. Default: 2.
HTTP_MAX_RETRIES=2

# --- Public URLs (decision D-015) ------------------------------------------
# REQUIRED, both of them. These used to be derived — the app origin from
# CORS_READ_ORIGINS[0], the API origin from HOST + PORT — and both derivations break
# behind a reverse proxy: HOST is a BIND address (0.0.0.0 is not somewhere a
# browser can go) and the first CORS origin is just whichever entry someone
# typed first. The symptom is a verification email pointing at an unreachable
# host, in the middle of the signup funnel.
#
# Where the browser application lives. Verification and reset links land here.
APP_URL=http://localhost:3000
# Where THIS service is publicly reachable. The verify link in email points here.
API_URL=http://localhost:4000

# --- Sessions / auth (consumed by the identity module, step 4) -------------
# REQUIRED. Session cookie name.
SESSION_COOKIE_NAME=foxxy_session
# OPTIONAL. Absolute session lifetime in days. Default: 30.
SESSION_TTL_DAYS=30

# --- Graceful shutdown (04-RESILIENCE-PLAN.md section 12) ------------------
# OPTIONAL. How long in-flight requests may take to drain on SIGTERM before
# the process stops waiting and closes its pools anyway. Default: 15000.
SHUTDOWN_DRAIN_TIMEOUT_MS=15000
# OPTIONAL. The same, for the worker process finishing its current job.
# Default: 30000.
SHUTDOWN_WORKER_TIMEOUT_MS=30000

# --- Docker compose only (not read by the application) ---------------------
# These configure docker/compose.yml. The app only ever sees DATABASE_URL.
POSTGRES_USER=foxxy
POSTGRES_PASSWORD=foxxy_dev_password
POSTGRES_DB=foxxy
POSTGRES_PORT=5433
VALKEY_PORT=6379

# --- External services (ports exist, adapters land in later build steps) ---
# Not yet required. Left here so the full surface is visible in one place.
# LLM_API_KEY=
# VOYAGE_API_KEY=
# RESEND_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Tenancy (decision D-073) ----------------------------------------------
# OPTIONAL. The tenant every account created on this deployment belongs to.
# Defaults to the single tenant migration 0004 seeds, so a single-tenant
# deployment never needs to set it.
#
# Signup is the only insert path in the product with no authenticated actor to
# inherit a tenant from, so the value has to come from somewhere; it comes from
# here and NEVER from a request body. A client-supplied tenant would let anyone
# choose which school's data namespace to join — there is a test that drives a
# signup carrying one and asserts it is ignored.
#
# When multi-tenancy arrives this stops being a constant and becomes a
# per-request resolution (subdomain -> tenant), in one place.
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111




# One-time corpus import from the legacy Supabase project. READ-ONLY.
# Session pooler string (IPv4). Put the REAL value in .env, never here.
SOURCE_DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
