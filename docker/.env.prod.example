# =============================================================================
# PRODUCTION COMPOSE ENVIRONMENT — copy to `docker/.env.prod` and fill in.
#
# `.env.prod` is gitignored (root .gitignore: `.env.*`). This file is TRACKED,
# so it documents variable NAMES and PLACEHOLDER SHAPES and never a real value.
#
# That rule is mechanically enforced. `npm run scan:secrets` (and the
# `secret-scan` CI job, which every other job fans into) fails the build on a
# credential-shaped value in any tracked `.env*` file. It exists because a real
# database password once reached a tracked `.env.example` and was caught only by
# eye — D-096.
# =============================================================================

# --- THE DOMAIN --------------------------------------------------------------
# THIS IS THE ONE PLACE THE REAL DOMAIN IS SET. Everything else derives from it:
#
#     ${BASE_DOMAIN}        marketing website
#     app.${BASE_DOMAIN}    product frontend
#     api.${BASE_DOMAIN}    backend API
#
# Caddy reads it directly (docker/caddy/Caddyfile), and compose.prod.yml builds
# APP_URL, API_URL, CORS_READ_ORIGINS and CORS_WRITE_ORIGINS from it — so the
# proxy's routing and the backend's origin allow-lists cannot disagree.
#
# `example.com` is a placeholder throughout the planning documents
# (06-FRONTEND-SEPARATION-PLAN.md, "Assumptions"). Replace it here, once.
BASE_DOMAIN=example.com

# Contact address for the ACME account. Certificate expiry warnings go here.
# Without it, a renewal failure is discovered by a user seeing a browser
# interstitial.
ACME_EMAIL=ops@example.com

# --- Database ----------------------------------------------------------------
POSTGRES_USER=foxxy
# REPLACE. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=<generate-a-32-byte-random-password>
POSTGRES_DB=foxxy

# --- Backend -----------------------------------------------------------------
LOG_LEVEL=info
SESSION_COOKIE_NAME=foxxy_session
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111

# --- Images ------------------------------------------------------------------
# Set by CI to an immutable, digest-or-SHA tag. `latest` is the local-build
# default only; a rollback needs a tag it can go BACK to, and `latest` is not
# one — see docs/runbooks/deploy-rollback.md.
BACKEND_IMAGE=foxxy/backend:latest
FRONTEND_IMAGE=foxxy/frontend:latest
WEBSITE_IMAGE=foxxy/website:latest

# --- Alerting (04-RESILIENCE-PLAN.md section 5) -------------------------------
# WHO GETS PAGED. Both are REQUIRED by the evaluator; it refuses to start
# without them rather than run and deliver nowhere, because an alerting system
# that silently reaches nobody is indistinguishable from a healthy system.
#
# ONCALL_USER_ID must be a real `users.id` — the in-app channel writes a row
# with a foreign key to it.
ONCALL_USER_ID=<uuid-of-the-on-call-operator-user>
ONCALL_EMAIL=oncall@example.com
# WHICH TRANSPORT CARRIES A PAGE. Compose defaults this to `smtp`, not
# `console`, and that inversion is deliberate (D-251).
#
#   smtp     the real pager path. Google Workspace, via the SMTP mail adapter
#            in backend/src/platform/mail. Requires the SMTP_* block below.
#   console  writes the alert to stdout, where the log driver keeps it. A real
#            delivery path for someone watching `docker compose logs` and NOT a
#            pager. The evaluator warns loudly on every start when it is chosen.
#   resend   REMOVED. The owner's mail provider is Google Workspace; selecting
#            it now fails with a message pointing at `smtp`.
#
# Setting this to `console` in production is allowed and visible. What is not
# allowed is a deployment that BELIEVES it pages a phone and does not.
ALERT_MAIL_TRANSPORT=smtp
# Where the evaluator reads the age of the newest base backup from. This is the
# read-only mount of the backup volume declared on the `backend-alerts` service.
# Without it the `backup_stale` rule is inert: it cannot observe its signal, so
# "there has never been a backup" and "backups are fine" look identical (D-251).
ALERT_BACKUP_DIR=/backup

# --- Backups (04-RESILIENCE-PLAN.md section 7) --------------------------------
# Nightly base backup, UTC. 02:30 UTC = 08:00 Asia/Kolkata.
BACKUP_AT_UTC=02:30
# How many days of base backups and superseded WAL to retain on the second
# volume. WAL older than the OLDEST retained base backup is unusable, so this
# one number bounds both.
BACKUP_RETAIN_DAYS=14

# --- External services --------------------------------------------------------
# Left as placeholders here. Real values go in `.env.prod` only, which is
# gitignored. A real credential reached a tracked example file once already
# (D-096); `tools/scan-secrets.mjs` now fails CI on any value in a tracked
# `.env*` file that is not an empty string or an obvious `<placeholder>`.
#
# EVERY VARIABLE IN THIS BLOCK IS REQUIRED IN PRODUCTION, and compose.prod.yml
# references them as `${VAR:?...}` — an unset one is a loud interpolation
# failure naming the variable, BEFORE any container is created, instead of a
# container that boots, throws inside the composition root and restart-loops
# (D-250). `docker compose config` is enough to detect it.

# The query-embedding key. Without it the composition root refuses to boot:
# the deterministic fake embeds into a vector space unrelated to the corpus and
# every retrieval returns confident, wrong chunks with no error.
VOYAGE_API_KEY=<voyage-api-key>

# The language-model key. Without it the composition root refuses to boot: the
# scripted fake answers every student with the same sentence, cited, over SSE.
LLM_API_KEY=<anthropic-api-key>
# OPTIONAL, both. The model id and API base URL, overridable without a code
# change so a model swap is a deploy variable rather than an edit.
#
# ⚠️ COMMENTED OUT, NOT `LLM_MODEL=`. THIS FILE IS COPIED TO `.env.prod`, AND
# THE EMPTY FORM STOPS THE STACK BOOTING. Both are `z.string().min(1)
# .optional()` — optional means ABSENT, and `LLM_MODEL=` is not absent, it is a
# present empty value. Measured: with these two assigned empty, `docker compose
# config` renders `LLM_MODEL: ''`, the container receives it, and the schema
# rejects it:
#
#     - LLM_MODEL: String must contain at least 1 character(s)
#     - LLM_BASE_URL: Invalid url
#
# compose.prod.yml uses the bare `LLM_MODEL:` form specifically so that an unset
# variable stays unset — and two empty assignments HERE defeated that, because
# the bare form passes through whatever the env file supplies. It is the D-250
# crash loop rebuilt inside the file that documents the fix for it, and only the
# pre-flight would have caught it, at deploy time. `docker compose config` is
# perfectly happy with it, so CI's compose validation could not.
#
# Absent = the adapter's own default, which is what production runs today.
# LLM_MODEL=<claude-model-id>
# LLM_BASE_URL=https://<llm-api-host>

# --- Payments (Razorpay) ------------------------------------------------------
# ALL THREE ARE REQUIRED IN PRODUCTION and the composition root throws without
# them. The degraded mode is the worst in the system: the fake gateway happily
# creates subscriptions and happily verifies webhooks signed with a secret we
# chose, so entitlements are granted against payments that never happened.
#
# RAZORPAY_WEBHOOK_SECRET IS A DIFFERENT SECRET from RAZORPAY_KEY_SECRET. It is
# set per endpoint in the Razorpay dashboard. Supplying the API secret in its
# place is a common misconfiguration whose only symptom is that every genuine
# webhook delivery fails its signature check while checkout keeps working.
RAZORPAY_KEY_ID=<rzp-key-id>
RAZORPAY_KEY_SECRET=<rzp-key-secret>
RAZORPAY_WEBHOOK_SECRET=<rzp-webhook-secret>
# Our plan code -> Razorpay's plan id, comma-separated `code:plan_id` pairs.
# A variable rather than a constant because a plan id is created in Razorpay's
# dashboard and DIFFERS between the test and live accounts — hardcoding one
# means a staging click subscribing a real card to a production plan.
#
# Both purchasable codes must be present. `scripts/ops/preflight-env.ts`
# refuses to start the stack on a malformed pair and NAMES the offending entry;
# without that the map silently resolves to `{}` and the first symptom is a
# customer's checkout failing (D-253).
RAZORPAY_PLAN_IDS=monthly:<rzp-plan-id-monthly>,yearly:<rzp-plan-id-yearly>

# --- Outbound mail (SMTP — Google Workspace) ----------------------------------
# The transport behind every verification email, password reset, digest AND
# every page-severity alert. `resend` is not used; the owner's provider is
# Google Workspace.
#
# ✅ NAMES RECONCILED (D-254). These were guessed while the SMTP adapter was
# still being written and passed through compose with soft `${VAR:-}` defaults,
# because marking a GUESSED name required would restart-loop production on a
# variable that does not exist — the D-250 defect from the other direction.
#
# One guess was wrong: this file and compose.prod.yml said `SMTP_USERNAME`; the
# schema says `SMTP_USER`. Compose would have set an unread variable and left the
# real one absent, so SMTP auth was impossible and every verification email and
# password reset would have failed — behind green probes. `npm run
# ops:env-contract` found it by comparing the two files, which is exactly what
# that gate exists for (D-255). All four are now `${VAR:?}` in compose: an unset
# one stops `docker compose config` and names itself, before an image is pulled.
SMTP_HOST=<smtp-host e.g. smtp.gmail.com>
SMTP_PORT=587
SMTP_USER=<no-reply@example.com>
# A GOOGLE WORKSPACE APP PASSWORD, not the account password.
SMTP_PASSWORD=<google-workspace-app-password>
# The envelope/From address. Must be a domain Google Workspace will relay for.
# Separate from SMTP_USER because Workspace allows sending as an alias, and a
# receiving spam filter treats the envelope sender and the visible From
# differently.
SMTP_FROM=<no-reply@example.com>

# --- Database TLS, proxy trust, migrations (all OPTIONAL here) ----------------
# Left unset deliberately, and each absence is a decision rather than an
# omission — `npm run ops:env-contract` fails CI on a schema variable that
# compose neither passes nor explains.
#
# DATABASE_SSL: postgres is a container on an `internal: true` network with no
# published port and no route out, so there is no path a listener could sit on.
# Set it to `true` — and set DATABASE_SSL_CA to the provider's root certificate —
# the moment the database moves to a managed host. Never DATABASE_SSL_INSECURE:
# that is TLS with the authentication removed, which reads in a manifest as the
# secure configuration (D-238).
# DATABASE_SSL=true
# DATABASE_SSL_CA=<provider-root-ca-pem>
#
# TRUSTED_PROXY_HOPS defaults to 1 in compose.prod.yml: exactly one proxy
# (caddy) fronts the API. Raise it only if another proxy is added in front of
# caddy — with the wrong count, every IP-keyed rate limit meters the wrong
# address (D-227).
# TRUSTED_PROXY_HOPS=1
#
# DRIZZLE_MIGRATIONS_DIR defaults to /app/drizzle/migrations in compose — an
# absolute path, so the readiness check cannot start reporting "no migrations
# found" because a service gained a `working_dir:` (D-231).
# DRIZZLE_MIGRATIONS_DIR=/app/drizzle/migrations

# --- Identity: the identifier-hash salt (D-221 / D-223) -----------------------
# STRONGLY RECOMMENDED. Optional in the schema only so that adding it does not
# restart-loop a stack that has not set it yet (D-250).
#
# `sessions.ip_hash` and every IP-keyed rate-limit cache key are SHA-256
# digests. There are only 2^32 IPv4 addresses, so an UNSALTED digest over that
# space is a rainbow table anybody can build in minutes — the column would be
# pseudonymised in name only. The identical digest is used in Valkey and in
# Postgres, so it also joins a cache dump to a database dump exactly.
#
# Unset, the app logs `identity.ip_hash_salt_unconfigured` at WARN on every boot
# and falls back to a build constant that is IN THE SOURCE and is not a secret.
# That defeats a generic precomputed table and nothing else.
#
# Minimum 32 characters — the schema refuses anything shorter, because a short
# salt is much closer to no salt than to a good one while still reading as
# "configured". An empty value is treated as absent.
#
# ROTATION IS NOT FREE: existing `sessions.ip_hash` rows stop correlating with
# new ones, and in-flight rate-limit counters reset once. Neither is an outage.
#   openssl rand -hex 32
#
# LEFT COMMENTED OUT ON PURPOSE. `compose.prod.yml` passes this with the bare
# `KEY:` form, so an assignment here — even an empty one — is the difference
# between the variable being ABSENT and being PRESENT AND BLANK. Uncomment it
# when you have a value; do not uncomment it empty.
# IDENTITY_IP_HASH_SALT=replace-me-with-openssl-rand-hex-32-output
