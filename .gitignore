backups/
.restore-drill/

# environment
.env
.env.*
!.env.example

# test artefacts
coverage/
.vitest/

# logs
*.log
npm-debug.log*
logs/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local docker volumes (named volumes live in docker, but just in case)
docker/data/

# corpus extraction staging (large, licensed content)
.corpus-extract/

# workspace
frontend/node_modules/
frontend/.next/
